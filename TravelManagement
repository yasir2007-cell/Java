                    System.out.println("List of Cities:"); 
                    if (cities.isEmpty()) { 
                        System.out.println("No cities available."); 
                    } else { 
                        for (String c : cities) { 
                            System.out.println(c); 
                        } 
                    } 
                    break; 
                case 6: 
                    System.out.println("Thank You!"); 
                    break; 
                default: 
                    System.out.println("Invalid Choice."); 
            } 
        } while (choice != 6); 
        sc.close(); 
    } 
} 
